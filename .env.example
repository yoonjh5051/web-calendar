# 관리자 계정 (http://localhost/login 에서 로그인)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-please

# 세션 서명 키. 비워두면 /data/.secret_key 에 자동 생성됩니다.
SECRET_KEY=

# 외부 포트 (기본 80 → http://localhost)
PORT=80

# 브라우저 탭/사이드바에 표시될 이름
APP_TITLE=My Calendar

# true: 누구나 보기 가능 (수정은 로그인 필요) / false: 보기도 로그인 필요
PUBLIC_VIEW=true

# HTTPS 리버스 프록시 뒤에서 운영할 때 true
COOKIE_SECURE=false

# 일정 시간 기준 타임존
APP_TZ=Asia/Seoul
